# Expo embeds EXPO_PUBLIC_ values in the app bundle. Never put secrets here.
# Android emulator: use 10.0.2.2 to reach the host computer.
# iOS simulator: use http://127.0.0.1:8000/api
# Physical device: use your computer's LAN address, not localhost.
# Use an HTTPS endpoint for production/native release builds.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
